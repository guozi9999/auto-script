<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="HardcodedText,ButtonStyle,LabelFor">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="16dp" />

        <!-- 主题设置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="外观"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="主题模式" />

            <Spinner
                android:id="@+id/spinnerTheme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:entries="@array/theme_options" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="字体大小" />

            <SeekBar
                android:id="@+id/seekBarFontSize"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:min="10"
                android:max="24"
                android:progress="14"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:id="@+id/tvFontSize"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="14号"
                android:gravity="center" />
        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 编辑器设置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="编辑器"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <CheckBox
            android:id="@+id/cbAutoSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="自动保存"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cbShowLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="显示日志"
            android:checked="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="日志级别" />

            <Spinner
                android:id="@+id/spinnerLogLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:entries="@array/log_level_options" />
        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 自动化设置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="自动化"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="默认置信度" />

            <SeekBar
                android:id="@+id/seekBarConfidence"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:min="50"
                android:max="100"
                android:progress="80"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:id="@+id/tvConfidence"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="80%"
                android:gravity="center" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="截图延迟（毫秒）" />

            <EditText
                android:id="@+id/etScreenshotDelay"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="100"
                android:importantForAutofill="no"
                android:hint="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="点击延迟（毫秒）" />

            <EditText
                android:id="@+id/etClickDelay"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="50"
                android:importantForAutofill="no"
                android:hint="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="滑动时长（毫秒）" />

            <EditText
                android:id="@+id/etSwipeDuration"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="300"
                android:importantForAutofill="no"
                android:hint="@null" />
        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 悬浮窗设置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="悬浮窗"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <CheckBox
            android:id="@+id/cbFloatingWindow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="启用悬浮窗"
            android:checked="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="悬浮窗透明度" />

            <SeekBar
                android:id="@+id/seekBarOpacity"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:min="30"
                android:max="100"
                android:progress="80"
                tools:ignore="UnusedAttribute" />

            <TextView
                android:id="@+id/tvOpacity"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:text="80%"
                android:gravity="center" />
        </LinearLayout>

        <!-- 分隔线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <!-- 高级设置 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="高级"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <CheckBox
            android:id="@+id/cbAutoBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="自动备份"
            android:checked="false" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="备份间隔 (小时)" />

            <EditText
                android:id="@+id/etBackupInterval"
                android:layout_width="100dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="24"
                android:importantForAutofill="no"
                android:hint="@null" />
        </LinearLayout>

        <!-- 按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="24dp"
            android:gravity="center">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="保存设置" />

            <Button
                android:id="@+id/btnReset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="重置默认"
                android:layout_marginStart="16dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
